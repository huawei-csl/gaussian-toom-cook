# libgtc -- Makefile
# Copyright (c) 2026 Huawei Technologies Co., Ltd.
# SPDX-License-Identifier: BSD-3-Clause-Clear
#
#   make                 the library (build/libgtc.a, build/libgtc.so), the
#                        benchmark and the tuner
#   make check           the tests
#   make install         PREFIX=/usr/local, DESTDIR for staging
#   make NO_ASM=1        the portable C build, without gtc's assembly
#   make B=build-x       objects and executables elsewhere (default build)
#   make GMP_PREFIX=dir  GMP installed under dir
#   CFLAGS (default -O2 -g and -march=native or -mcpu=native), EXTRA_CFLAGS
#   (added to CFLAGS), CPPFLAGS and LDFLAGS are taken as usual.
#
# The defaults are tuned per microarchitecture and selected at compile time
# (-march=native, -mcpu=native on aarch64), as GMP selects its kernels.
# build/gmp_decls.h, the declarations of the few GMP internals libgtc
# calls, is taken from the GMP 6.3.0 source by tools/fetch_gmp.sh, which
# downloads it once (GMP_TARBALL=path uses a local copy).

VERSION = 0.1.0
SOMAJOR = 0

ARCH    := $(shell uname -m)
ifeq ($(ARCH),aarch64)
NATIVE  = -mcpu=native
else
NATIVE  = -march=native
endif
B       ?= build
CFLAGS  ?= -O2 -g $(NATIVE)
# The flags every build needs, kept apart so that CFLAGS can be replaced.
GTC_FLAGS = -std=gnu17 -Wall -Wextra -Iinclude -I$(B)
ifeq ($(NO_ASM),1)
GTC_FLAGS += -DGTC_NO_ASM
endif
LDLIBS  = -lgmp

GMP_PREFIX ?=
ifneq ($(GMP_PREFIX),)
GTC_FLAGS += -I$(GMP_PREFIX)/include
LDLIBS  := -L$(GMP_PREFIX)/lib -Wl,-rpath,$(GMP_PREFIX)/lib $(LDLIBS)
endif
GTC_FLAGS += $(CPPFLAGS) $(EXTRA_CFLAGS)
ALL_CFLAGS = $(CFLAGS) $(GTC_FLAGS)

PREFIX     ?= /usr/local
LIBDIR     ?= $(PREFIX)/lib
INCLUDEDIR ?= $(PREFIX)/include

# src/gtc.c includes the other parts: one translation unit.
SRC     = src/gtc.c src/config.h src/ctx.c src/linear.c src/gauss.c \
	  src/gauss_toom4.c src/gauss_toom5.c src/rational.c
DECLS   = $(B)/gmp_decls.h
HDRS    = include/gtc.h $(DECLS)

# The assembly, generated by tools/gen_*.py (make asm); each file
# assembles to nothing on the other architecture.
ASM_S   = src/gtc_textbook_x86.S src/gtc_linear_x86.S src/gtc_kara_x86.S \
	  src/gtc_avx512_x86.S \
	  src/gtc_textbook_arm.S src/gtc_linear_arm.S src/gtc_kara_arm.S \
	  src/gtc_km_arm.S
ifeq ($(NO_ASM),1)
ASM_S   :=
endif
ASM     = $(ASM_S:src/%.S=$(B)/%.o)
OBJS    = $(B)/gtc.o $(ASM)
PIC_OBJS = $(OBJS:$(B)/%=$(B)/pic/%)

SHLIB   = libgtc.so.$(VERSION)
LIBS    = $(B)/libgtc.a $(B)/$(SHLIB)
BINS    = $(B)/bench_gtc $(B)/tune_gauss

all: $(LIBS) $(BINS)

$(B) $(B)/pic:
	mkdir -p $@

$(DECLS): tools/fetch_gmp.sh | $(B)
	./tools/fetch_gmp.sh $@

$(B)/%.o: src/%.S | $(B)
	$(CC) $(ALL_CFLAGS) -c -o $@ $<

$(B)/pic/%.o: src/%.S | $(B)/pic
	$(CC) $(ALL_CFLAGS) -fPIC -c -o $@ $<

# The AVX-512 pass with no branch crossing or ending on a 32-byte boundary
# (the JCC erratum of the Skylake family).
ifeq ($(ARCH),x86_64)
$(B)/gtc_avx512_x86.o $(B)/pic/gtc_avx512_x86.o $(B)/zen/gtc_avx512_x86.o: \
  GTC_FLAGS += -Wa,-mbranches-within-32B-boundaries
endif

$(B)/gtc.o: $(SRC) $(HDRS) | $(B)
	$(CC) $(ALL_CFLAGS) -c -o $@ src/gtc.c

$(B)/pic/gtc.o: $(SRC) $(HDRS) | $(B)/pic
	$(CC) $(ALL_CFLAGS) -fPIC -c -o $@ src/gtc.c

$(B)/libgtc.a: $(OBJS)
	rm -f $@
	$(AR) rcs $@ $(OBJS)

$(B)/$(SHLIB): $(PIC_OBJS) src/libgtc.map
	$(CC) -shared -Wl,-soname,libgtc.so.$(SOMAJOR) \
	  -Wl,--version-script,src/libgtc.map -o $@ $(PIC_OBJS) $(LDFLAGS) \
	  $(LDFLAGS) $(LDLIBS)
	ln -sf $(SHLIB) $(B)/libgtc.so.$(SOMAJOR)
	ln -sf $(SHLIB) $(B)/libgtc.so

# Regenerate the assembly (needs python3).
asm:
	./tools/gen_textbook.py > src/gtc_textbook_x86.S
	./tools/gen_linear.py > src/gtc_linear_x86.S
	./tools/gen_kara.py > src/gtc_kara_x86.S
	./tools/gen_avx512.py > src/gtc_avx512_x86.S
	./tools/gen_textbook_arm.py > src/gtc_textbook_arm.S
	./tools/gen_linear_arm.py > src/gtc_linear_arm.S
	./tools/gen_kara_arm.py > src/gtc_kara_arm.S
	./tools/gen_km_arm.py > src/gtc_km_arm.S

$(B)/bench_gtc: bench/bench_gtc.c $(B)/libgtc.a $(HDRS)
	$(CC) $(ALL_CFLAGS) -o $@ bench/bench_gtc.c $(B)/libgtc.a $(LDFLAGS) \
	  $(LDLIBS) -lm

# The tuner includes src/gtc.c, to time its internal functions.
$(B)/tune_gauss: bench/tune_gauss.c $(SRC) $(HDRS) $(ASM)
	$(CC) $(ALL_CFLAGS) -Isrc -o $@ bench/tune_gauss.c $(ASM) $(LDFLAGS) \
	  $(LDLIBS)

# Tests.  test_gtc against GMP; test_helpers white-box, including
# src/gtc.c.  The C path without the assembly (_c), and with the two-pass
# halving instead of GMP's mpn_rsh1add_n and mpn_rsh1sub_n, which a GMP
# built without assembly lacks (_rsh1c).  On x86-64 the Zen's paths as
# well, whatever the machine (_zen: the C with GTC_ZEN, the assembly with
# __znver3__).
TESTS   = $(B)/test_gtc $(B)/test_helpers $(B)/test_gtc_c $(B)/test_gtc_rsh1c
ifeq ($(ARCH),x86_64)
ifneq ($(NO_ASM),1)
TESTS  += $(B)/test_gtc_zen $(B)/test_helpers_zen
endif
endif
ZEN_ASM = $(ASM_S:src/%.S=$(B)/zen/%.o)

$(B)/zen:
	mkdir -p $@

$(B)/zen/%.o: src/%.S | $(B)/zen
	$(CC) $(ALL_CFLAGS) -D__znver3__ -c -o $@ $<

$(B)/test_gtc: tests/test_gtc.c $(B)/libgtc.a $(HDRS)
	$(CC) $(ALL_CFLAGS) -o $@ tests/test_gtc.c $(B)/libgtc.a $(LDFLAGS) \
	  $(LDLIBS)

$(B)/test_helpers: tests/test_helpers.c $(SRC) $(HDRS) $(ASM)
	$(CC) $(ALL_CFLAGS) -Isrc -o $@ tests/test_helpers.c $(ASM) $(LDFLAGS) \
	  $(LDLIBS)

$(B)/test_gtc_c: tests/test_gtc.c $(SRC) $(HDRS)
	$(CC) $(ALL_CFLAGS) -DGTC_NO_ASM -o $@ tests/test_gtc.c src/gtc.c \
	  $(LDFLAGS) $(LDLIBS)

$(B)/test_gtc_rsh1c: tests/test_gtc.c $(SRC) $(HDRS)
	$(CC) $(ALL_CFLAGS) -DGTC_NO_ASM -DGTC_RSH1_C -o $@ tests/test_gtc.c \
	  src/gtc.c $(LDFLAGS) $(LDLIBS)

$(B)/test_gtc_zen: tests/test_gtc.c $(SRC) $(HDRS) $(ZEN_ASM)
	$(CC) $(ALL_CFLAGS) -DGTC_ZEN=1 -o $@ tests/test_gtc.c src/gtc.c \
	  $(ZEN_ASM) $(LDFLAGS) $(LDLIBS)

$(B)/test_helpers_zen: tests/test_helpers.c $(SRC) $(HDRS) $(ZEN_ASM)
	$(CC) $(ALL_CFLAGS) -DGTC_ZEN=1 -Isrc -o $@ tests/test_helpers.c \
	  $(ZEN_ASM) $(LDFLAGS) $(LDLIBS)

# Each test's output to its .log, the last line shown, the whole on failure.
RUN = run () { echo "== $$*"; "$$@" > $$1.log 2>&1 || { cat $$1.log; \
      return 1; }; tail -1 $$1.log; }; run

check: $(TESTS)
	@for t in $(TESTS); do $(RUN) $$t || exit 1; done

# Every scratch block from malloc, so that overruns hit a block boundary.
# AddressSanitizer sees the accesses of the C code only; valgrind also
# those of the assembly and of libgmp.
$(B)/test_gtc_asan: tests/test_gtc.c $(SRC) $(HDRS) $(ASM_S) | $(B)
	$(CC) -O1 -g $(NATIVE) $(GTC_FLAGS) -fsanitize=address,undefined \
	  -fno-sanitize-recover=all -fno-omit-frame-pointer -DGTC_NO_ARENA \
	  -o $@ tests/test_gtc.c src/gtc.c $(ASM_S) $(LDFLAGS) $(LDLIBS)

$(B)/test_gtc_vg: tests/test_gtc.c $(SRC) $(HDRS) $(ASM_S) | $(B)
	$(CC) -O1 -g $(NATIVE) $(GTC_FLAGS) -DGTC_NO_ARENA -o $@ \
	  tests/test_gtc.c src/gtc.c $(ASM_S) $(LDFLAGS) $(LDLIBS)

check-asan: $(B)/test_gtc_asan
	@$(RUN) $(B)/test_gtc_asan

check-valgrind: $(B)/test_gtc_vg
	valgrind -q --error-exitcode=9 $(B)/test_gtc_vg > $(B)/test_gtc_vg.log \
	  2>&1 || { cat $(B)/test_gtc_vg.log; exit 1; }
	tail -1 $(B)/test_gtc_vg.log

# Remade on every install, for the PREFIX of that install.
GMP_PC_CFLAGS = $(if $(GMP_PREFIX), -I$(GMP_PREFIX)/include)
GMP_PC_LIBS   = $(if $(GMP_PREFIX), -L$(GMP_PREFIX)/lib)
$(B)/libgtc.pc: FORCE | $(B)
	printf '%s\n' 'prefix=$(PREFIX)' 'libdir=$(LIBDIR)' \
	  'includedir=$(INCLUDEDIR)' '' 'Name: libgtc' \
	  'Description: Gaussian Toom-Cook multiplication over GMP' \
	  'Version: $(VERSION)' \
	  'Libs: -L$${libdir} -lgtc$(GMP_PC_LIBS) -lgmp' \
	  'Cflags: -I$${includedir}$(GMP_PC_CFLAGS)' > $@

FORCE:

install: $(LIBS) $(B)/libgtc.pc
	install -d $(DESTDIR)$(LIBDIR)/pkgconfig $(DESTDIR)$(INCLUDEDIR)
	install -m 644 include/gtc.h $(DESTDIR)$(INCLUDEDIR)
	install -m 644 $(B)/libgtc.a $(DESTDIR)$(LIBDIR)
	install -m 755 $(B)/$(SHLIB) $(DESTDIR)$(LIBDIR)
	ln -sf $(SHLIB) $(DESTDIR)$(LIBDIR)/libgtc.so.$(SOMAJOR)
	ln -sf $(SHLIB) $(DESTDIR)$(LIBDIR)/libgtc.so
	install -m 644 $(B)/libgtc.pc $(DESTDIR)$(LIBDIR)/pkgconfig

uninstall:
	rm -f $(DESTDIR)$(INCLUDEDIR)/gtc.h $(DESTDIR)$(LIBDIR)/libgtc.a \
	  $(DESTDIR)$(LIBDIR)/$(SHLIB) $(DESTDIR)$(LIBDIR)/libgtc.so.$(SOMAJOR) \
	  $(DESTDIR)$(LIBDIR)/libgtc.so $(DESTDIR)$(LIBDIR)/pkgconfig/libgtc.pc

# The objects and executables; the GMP tarball is kept.
clean:
	rm -rf $(B)/pic $(B)/zen $(B)/*.o $(B)/*.a $(B)/libgtc.so* $(B)/libgtc.pc \
	  $(BINS) $(B)/test_*

.PHONY: FORCE all asm check check-asan check-valgrind install uninstall clean
